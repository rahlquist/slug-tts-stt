[Unit]
Description=FLM ASR (Whisper large-v3-turbo) on AMD XDNA2 NPU - STT backend
Documentation=https://github.com/FastFlowLM/FastFlowLM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rahlquist
Group=rahlquist
WorkingDirectory=/home/rahlquist
# FLM requires unlimited locked memory to initialize the NPU (validate fails at 8MB).
LimitMEMLOCK=infinity
# Standalone ASR server mode: flm v0.9.21+ serves whisper without an LLM tag.
# Passing whisper-v3:turbo as the model tag made flm try (and fail) to load it as
# an LLM -> "Unsupported model family or non-llm" + a co-loaded llama3.2:1b.
# Bound to localhost: the whisper-proxy on :8081 is the LAN-facing interface.
ExecStart=/usr/bin/flm serve --asr 1 --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
